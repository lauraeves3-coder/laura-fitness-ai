OPENAI_API_KEY=SUA_CHAVE_AQUI
OPENAI_MODEL=gpt-5.6

PORT=3000

WHATSAPP_VERIFY_TOKEN=crie_um_token_secreto
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App Secret do Meta, necessário para validar a assinatura do webhook.
WHATSAPP_APP_SECRET=

# Gere um token aleatório com pelo menos 32 caracteres para as rotas /api.
API_ACCESS_TOKEN=

# Opcionais
# Modelo de transcrição dos áudios do WhatsApp (padrão: gpt-4o-mini-transcribe).
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Caminho do banco SQLite (padrão: fitness.db na raiz do projeto).
# FITPULSE_DB_PATH=/dados/fitness.db
# Alimentos extras em JSON (padrão: data/catalogo-extra.json).
# FITPULSE_CATALOG_EXTRA=/dados/catalogo-extra.json

# Strava (opcional): app criado em https://www.strava.com/settings/api
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# Endereço público do servidor (ex.: o do túnel). Sem ele, o retorno usa http://localhost:PORT.
# PUBLIC_BASE_URL=https://seu-endereco.trycloudflare.com
